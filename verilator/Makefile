# Makefile for BitPack Verilator evaluation

# Build steps (see doc/verilator_eval_spec.md):
#   1. generate C++ code from hdl/*.sv into the verilated/ folder
#   2. build the verilated code into libVuser_wrapper.a via Vuser_wrapper.mk
#   3. compile the testbench and link it with the library into bitpack_eval

VERILATOR    = verilator
TOP          = user_wrapper
VERILATED    = verilated
TB_DIR       = testbench
BIN          = bitpack_eval

# the HDL templates causes non-significant warnings, such as intentionally unused
# signals/parameters, so the related warnings are disabled
VERILATOR_FLAGS = --cc -Wall -O2 -Mdir $(VERILATED) \
                  --top-module $(TOP) \
                  -Wno-EOFNEWLINE -Wno-UNUSEDSIGNAL -Wno-UNDRIVEN -Wno-UNUSEDPARAM \
                  -Wno-DECLFILENAME -Wno-GENUNNAMED \
                  -CFLAGS "-O2" -LDFLAGS "-O2"

TB_SRCS   = $(TB_DIR)/bitpack_test.cpp $(TB_DIR)/bitpack_lib_rand.cpp
TB_OBJS   = $(addprefix $(VERILATED)/,$(notdir $(TB_SRCS:.cpp=.o)))
TB_HDRS   = $(wildcard $(TB_DIR)/*.hpp)
LIB       = $(VERILATED)/libV$(TOP).a
VL_ROOT   = $(shell $(VERILATOR) --getenv VERILATOR_ROOT)
CXXFLAGS  = -O2 -I$(VERILATED) -I$(TB_DIR) -I$(VL_ROOT)/include -I$(VL_ROOT)/include/vltstd

.PHONY: all run clean

all: $(BIN)

# step 1: code generation
$(VERILATED)/V$(TOP).mk: $(wildcard hdl/*.sv)
	$(VERILATOR) $(VERILATOR_FLAGS) $(wildcard hdl/*.sv)

# step 2: build the library with the Makefile generated by Verilator
$(LIB): $(VERILATED)/V$(TOP).mk
	$(MAKE) -C $(VERILATED) -f V$(TOP).mk -j

# step 3: compile the testbench and link
$(VERILATED)/%.o: $(TB_DIR)/%.cpp $(TB_HDRS) | $(LIB)
	g++ $(CXXFLAGS) -MMD -c $< -o $@

$(BIN): $(TB_OBJS) $(LIB)
	g++ $(CXXFLAGS) -o $@ $(TB_OBJS) $(LIB) $(VERILATED)/libverilated.a

-include $(TB_OBJS:.o=.d)

run: $(BIN)
	./$(BIN)

clean:
	rm -rf $(VERILATED) $(BIN) results.txt input.txt output.txt
